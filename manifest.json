{
  "manifest_version": 3,
  "name": "Crunchyroll PiP",
  "version": "1.1.2",
  "description": "Um clique para assistir em janela flutuante. Sem coleta de dados.",
  "permissions": ["scripting"],
  "host_permissions": ["https://*.crunchyroll.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Crunchyroll PiP — abrir / fechar janela flutuante", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "content_scripts": [{ "matches": ["https://*.crunchyroll.com/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle" }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'" }
}
